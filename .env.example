# Kanban 环境变量配置

# ========== Docker 配置 ==========
# Docker 容器端口映射（宿主机端口:容器端口）
DOCKER_PORT=8080

# ========== AI 服务配置 ==========
# 第三方 OpenAI 兼容 API（示例）

# API Key
API_KEY=your-api-key

# API 地址（不含 /chat/completions）
API_BASE_URL=https://your-api-endpoint/v2

# 模型名称
AI_MODEL=your-model-name

# AI 服务端口（默认 3002）
AI_SERVICE_PORT=3002

# ========== 定时任务配置 ==========
# 测试模式：设置为 true 时，定时任务每1分钟触发（用于测试）
# 生产模式：设置为 false 时，定时任务每天17:00触发
TEST_MODE=false

# ========== SMTP 邮件配置 ==========
# SMTP 服务器地址
# 163邮箱: smtp.163.com
# Gmail: smtp.gmail.com
# Yahoo: smtp.mail.yahoo.com
SMTP_SERVER=smtp.163.com

# SMTP 端口（163邮箱用465，Gmail用587）
SMTP_PORT=465

# SMTP 用户名（通常是邮箱地址）
SMTP_USER=your-email@163.com

# SMTP 密码（163邮箱需要使用授权码，不是登录密码）
SMTP_PASSWORD=your-authorization-code

# 收件人列表（多个收件人用逗号分隔）
RECIPIENTS=user1@example.com,user2@example.com

# ========== 其他配置 ==========
# Anthropic Claude（备选）
# ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI（备选）
# OPENAI_API_KEY=your-openai-api-key